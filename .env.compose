# ============================================================
# BookBrow – Docker Compose Environment Variables
# Copy this file to .env.compose and fill in your values.
# Run with:  docker compose --env-file .env.compose up --build
# ============================================================

# ── Supabase PostgreSQL (Pooler URL) ──────────────────────────────────────────
DB_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.fjkuckbkygyamsahgyru
DB_PASSWORD=your_supabase_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=3600000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ── Mobile – Your machine's LAN IP ───────────────────────────────────────────
# Run `ipconfig` and use the IPv4 Address of your Wi-Fi adapter
# e.g. 192.168.1.5  (your phone must be on the same Wi-Fi network)
HOST_IP=192.168.1.5
