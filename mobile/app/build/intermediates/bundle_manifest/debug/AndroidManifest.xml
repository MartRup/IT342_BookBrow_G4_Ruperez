<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="edu.ruperez.bookbrow"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="edu.ruperez.bookbrow.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="edu.ruperez.bookbrow.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookBrow"
        android:usesCleartextTraffic="true" >

        <!-- Splash / Entry point -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.BookBrow.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth screens -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="edu.ruperez.bookbrow.feature.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main (post-login) -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.main.MainActivity"
            android:exported="false" />

        <!-- Admin screens -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name="edu.ruperez.bookbrow.feature.admin.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="edu.ruperez.bookbrow.feature.admin.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Books screen -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.books.BooksActivity"
            android:exported="false" />

        <!-- Records screen -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.borrow.RecordsActivity"
            android:exported="false" />

        <!-- Librarian screens -->
        <activity
            android:name="edu.ruperez.bookbrow.feature.librarian.LibrarianDashboardActivity"
            android:exported="false" />
        <activity
            android:name="edu.ruperez.bookbrow.feature.librarian.LibrarianUsersActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="edu.ruperez.bookbrow.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>