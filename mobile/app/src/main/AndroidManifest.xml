<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookBrow"
        android:usesCleartextTraffic="true">

        <!-- Splash / Entry point -->
        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.BookBrow.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth screens -->
        <activity
            android:name=".feature.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main (post-login) -->
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false" />

        <!-- Admin screens -->
        <activity
            android:name=".feature.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".feature.admin.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".feature.admin.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Books screen -->
        <activity
            android:name=".feature.books.BooksActivity"
            android:exported="false" />

        <!-- Records screen -->
        <activity
            android:name=".feature.borrow.RecordsActivity"
            android:exported="false" />

        <!-- Librarian screens -->
        <activity
            android:name=".feature.librarian.LibrarianDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".feature.librarian.LibrarianUsersActivity"
            android:exported="false" />

    </application>

</manifest>

